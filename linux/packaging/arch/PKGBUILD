pkgname=subdock
pkgver=0.0.0
pkgrel=1
pkgdesc='Native desktop manager for Sub-Store'
arch=('x86_64')
url='https://github.com/Delusions6515/SubDock'
license=('GPL-3.0-only')
depends=('gtk3' 'webkit2gtk-4.1' 'libayatana-appindicator' 'libayatana-indicator')
options=('!strip')
source=('subdock.desktop')
sha256sums=('SKIP')

package() {
  install -dm755 "$pkgdir/opt/$pkgname"
  cp -a "$startdir/bundle/." "$pkgdir/opt/$pkgname/"
  install -dm755 "$pkgdir/usr/bin"
  ln -s "/opt/$pkgname/SubDock" "$pkgdir/usr/bin/subdock"
  install -Dm644 \
    "$pkgdir/opt/$pkgname/data/icon/app_icon.png" \
    "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/org.substore.subdock.png"
  install -Dm644 "$startdir/subdock.desktop" \
    "$pkgdir/usr/share/applications/subdock.desktop"
}
